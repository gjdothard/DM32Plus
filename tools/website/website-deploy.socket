[Unit]
Description=Accept verified website deployment requests
[Socket]
ListenStream=/run/website-updater/deploy.sock
SocketUser=root
SocketGroup=website-updater
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=1
RemoveOnStop=yes
[Install]
WantedBy=sockets.target
